{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Everything Editor",
  "version": "1.6.0",
  "identifier": "com.mdgverse.ee",
  "build": {
    "frontendDist": "../src",
    "beforeBuildCommand": "npm run frontend",
    "beforeDevCommand": "npm run frontend"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Everything Editor",
        "width": 1280,
        "height": 800,
        "minWidth": 640,
        "minHeight": 420,
        "resizable": true,
        "center": true,
        "focus": true,
        "visible": false,
        "decorations": true,
        "transparent": false,
        "shadow": true,
        "dragDropEnabled": false,
        "zoomHotkeysEnabled": true,
        "backgroundColor": "#1e1e1e"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: asset: http://asset.localhost; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' ipc: http://ipc.localhost https://fonts.googleapis.com https://fonts.gstatic.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "copyright": "Copyright (c) mdgverse",
    "category": "DeveloperTool",
    "shortDescription": "Everything Editor",
    "longDescription": "Everything Editor - editor desktop leve e rapido.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "PortugueseBR",
          "English"
        ],
        "displayLanguageSelector": false,
        "compression": "lzma"
      }
    }
  }
}
