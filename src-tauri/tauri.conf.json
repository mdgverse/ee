{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EE Editor",
  "version": "0.1.0",
  "identifier": "com.mdgverse.ee",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "EE Editor",
        "width": 1280,
        "height": 800,
        "minWidth": 640,
        "minHeight": 420,
        "resizable": true,
        "center": true,
        "focus": true,
        "visible": false,
        "decorations": true,
        "transparent": false,
        "shadow": true,
        "dragDropEnabled": false,
        "zoomHotkeysEnabled": true,
        "backgroundColor": "#1e1e1e"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "copyright": "Copyright (c) mdgverse",
    "category": "DeveloperTool",
    "shortDescription": "EE Editor",
    "longDescription": "EE Editor - editor desktop leve e rapido.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["PortugueseBR", "English"],
        "displayLanguageSelector": false,
        "compression": "lzma"
      }
    }
  }
}
